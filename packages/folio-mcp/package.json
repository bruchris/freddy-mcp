{
  "name": "@bruchris/folio-mcp",
  "version": "0.1.0",
  "description": "MCP server, CLI, and typed client for Folio bank accounts (api.folio.no/v2).",
  "type": "module",
  "license": "MIT",
  "author": "Christian Bru (https://bruchris.me)",
  "keywords": [
    "mcp",
    "folio",
    "banking",
    "norway",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "folio-mcp": "dist/stdio.js",
    "folio-mcp-http": "dist/http.js",
    "folio": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/stdio.js",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "dev": "node ../../node_modules/tsx/dist/cli.mjs src/stdio.ts",
    "cli": "node ../../node_modules/tsx/dist/cli.mjs src/cli.ts",
    "auth": "node ../../node_modules/tsx/dist/cli.mjs src/auth.ts",
    "http": "node ../../node_modules/tsx/dist/cli.mjs src/http.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruchris/freddy-mcp.git",
    "directory": "packages/folio-mcp"
  },
  "homepage": "https://github.com/bruchris/freddy-mcp/tree/main/packages/folio-mcp#readme",
  "bugs": {
    "url": "https://github.com/bruchris/freddy-mcp/issues"
  }
}
